<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>stat</AssemblyName>
    <RootNamespace>Stat</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <DebugType>embedded</DebugType>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <Version>1.0.0</Version>
    <Product>stat</Product>
    <Description>Windows process monitor with a live web dashboard and HTML reports.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the .NET SDK build for .NET Framework without a targeting pack installed. Build-time only. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="web\index.html" LogicalName="web/index.html" />
    <EmbeddedResource Include="web\app.css" LogicalName="web/app.css" />
    <EmbeddedResource Include="web\app.js" LogicalName="web/app.js" />
    <EmbeddedResource Include="web\vendor\chart.umd.min.js" LogicalName="web/chart.umd.min.js" />
    <EmbeddedResource Include="web\vendor\fonts\b612-400.woff2" LogicalName="web/fonts/b612-400.woff2" />
    <EmbeddedResource Include="web\vendor\fonts\b612-700.woff2" LogicalName="web/fonts/b612-700.woff2" />
  </ItemGroup>

</Project>
